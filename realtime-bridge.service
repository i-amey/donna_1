# /etc/systemd/system/realtime-bridge.service

[Unit]
Description=Realtime voice bridge
After=network-online.target
Wants=network-online.target

[Service]
Type=simple
User=ubuntu
WorkingDirectory=/home/ubuntu/hermes-stack/bridge
EnvironmentFile=/home/ubuntu/hermes-stack/bridge/.env
ExecStart=/home/ubuntu/hermes-stack/bridge/.venv/bin/uvicorn main:app --host 127.0.0.1 --port 8080
Restart=always
RestartSec=5

[Install]
WantedBy=multi-user.target
